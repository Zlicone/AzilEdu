@page "/donations/edit/{Id:int}"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Uredi donaciju</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <MudPaper Class="pa-4">
        <MudSelect T="int" Label="Donator" @bind-Value="model.DonorId" Required="true" Class="mb-3">
            @foreach (var donor in donors)
            {
                <MudSelectItem T="int" Value="@donor.Id">@donor.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Label="Tip donacije"
                   Value="model.DonationTypeId"
                   ValueChanged="OnTypeChanged"
                   Required="true" Class="mb-3">
            @foreach (var type in types)
            {
                <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Label="Status" @bind-Value="model.DonationStatusId" Required="true" Class="mb-3">
            @foreach (var status in statuses)
            {
                <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudDatePicker Label="Datum donacije" @bind-Date="donationDate"
                       MaxDate="DateTime.Today" Class="mb-3" />

        @if (IsMoneyDonation())
        {
            <MudNumericField T="decimal?" Label="Iznos (€)" @bind-Value="model.Amount"
                             Min="0" Format="N2" Class="mb-3" />
        }
        else
        {
            <MudTextField Label="Naziv stvari" @bind-Value="model.ItemName"
                          Required="true" Immediate="true" Class="mb-3" />
            <MudNumericField T="decimal?" Label="Količina" @bind-Value="model.Quantity"
                             Min="0" Class="mb-3" />
            <MudNumericField T="decimal?" Label="Procijenjena vrijednost (€)" @bind-Value="model.EstimatedValue"
                             Min="0" Format="N2" Class="mb-3" />
        }

        <MudTextField Label="Napomena" @bind-Value="model.Notes" Lines="3" Immediate="true" Class="mb-4" />

        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">AI zahvala donatoru</MudText>
            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                <MudSelect T="string" Label="Ton poruke" @bind-Value="selectedTone" Variant="Variant.Outlined">
                    <MudSelectItem Value='@("Topao")'>Topao</MudSelectItem>
                    <MudSelectItem Value='@("Formalan")'>Formalan</MudSelectItem>
                    <MudSelectItem Value='@("Kratak")'>Kratak</MudSelectItem>
                </MudSelect>
                <MudButton ButtonType="ButtonType.Button"
                           OnClick="GenerateThankYou"
                           Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Disabled="isGeneratingThankYou">
                    @(isGeneratingThankYou ? "Generiram..." : "Generiraj zahvalu")
                </MudButton>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(thankYouText))
            {
                <MudTextField @bind-Value="thankYouText"
                              Label="Uredivi prijedlog poruke"
                              Lines="4"
                              Variant="Variant.Outlined"
                              Class="mt-3" />
            }
        </MudPaper>

        <MudButton ButtonType="ButtonType.Button"
                   OnClick="UpdateDonation"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Spremi promjene
        </MudButton>

        <MudButton Href="/donations" Variant="Variant.Text" Class="ml-2">
            Odustani
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private SaveDonationDto model = new();

    private List<LookupDto> donors = new();
    private List<LookupDto> types = new();
    private List<LookupDto> statuses = new();

    private DateTime? donationDate;

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            donors = await Http.GetFromJsonAsync<List<LookupDto>>("api/donors/lookup") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationtypes") ?? new();
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/donationstatuses") ?? new();

            var donation = await Http.GetFromJsonAsync<DonationDto>($"api/donations/{Id}");

            if (donation is not null)
            {
                model = new SaveDonationDto
                {
                    DonationDate = donation.DonationDate,
                    Amount = donation.Amount,
                    ItemName = donation.ItemName,
                    Quantity = donation.Quantity,
                    EstimatedValue = donation.EstimatedValue,
                    Notes = donation.Notes,
                    DonorId = donation.DonorId,
                    DonationTypeId = donation.DonationTypeId,
                    DonationStatusId = donation.DonationStatusId
                };

                donationDate = donation.DonationDate;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja donacije: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsMoneyDonation()
    {
        var type = types.FirstOrDefault(t => t.Id == model.DonationTypeId);
        return type is not null && type.Name == "Novčana";
    }

    private void OnTypeChanged(int newTypeId)
    {
        model.DonationTypeId = newTypeId;

        if (IsMoneyDonation())
        {
            model.ItemName = string.Empty;
            model.Quantity = null;
            model.EstimatedValue = null;
        }
        else
        {
            model.Amount = null;
        }
    }

    private string? ValidateForm()
    {
        if (model.DonorId <= 0)
            return "Odaberi donatora.";

        if (model.DonationTypeId <= 0)
            return "Odaberi tip donacije.";

        if (model.DonationStatusId <= 0)
            return "Odaberi status donacije.";

        if (!donationDate.HasValue)
            return "Odaberi datum donacije.";

        if (donationDate.Value.Date > DateTime.Today)
            return "Datum donacije ne smije biti u budućnosti.";

        if (model.Quantity.HasValue && model.Quantity.Value < 0)
            return "Količina ne smije biti negativna.";

        if (model.EstimatedValue.HasValue && model.EstimatedValue.Value < 0)
            return "Procijenjena vrijednost ne smije biti negativna.";

        if (IsMoneyDonation())
        {
            if (!model.Amount.HasValue || model.Amount.Value <= 0)
                return "Za novčanu donaciju upiši iznos veći od nule.";
        }
        else
        {
            if (string.IsNullOrWhiteSpace(model.ItemName))
                return "Upiši naziv materijalne donacije ili usluge.";

            if (!model.Quantity.HasValue || model.Quantity.Value <= 0)
                return "Upiši količinu veću od nule.";
        }

        return null;
    }

    private async Task UpdateDonation()
    {
        try
        {
            errorMessage = null;

            var validationError = ValidateForm();

            if (validationError is not null)
            {
                errorMessage = validationError;
                return;
            }

            model.DonationDate = donationDate!.Value;

            var response = await Http.PutAsJsonAsync($"api/donations/{Id}", model);

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadAsStringAsync();

                errorMessage = string.IsNullOrWhiteSpace(apiMessage)
                    ? $"Promjene nisu spremljene. Status: {(int)response.StatusCode}"
                    : apiMessage;

                return;
            }

            Navigation.NavigateTo("/donations");
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
    }

    private string selectedTone = "Topao";
    private string? thankYouText;
    private bool isGeneratingThankYou;

    private async Task GenerateThankYou()
    {
        isGeneratingThankYou = true;
        errorMessage = null;

        try
        {
            var donorName = donors
                .FirstOrDefault(item => item.Id == model.DonorId)?.Name
                ?? "Donator";

            var donationType = types
                .FirstOrDefault(item => item.Id == model.DonationTypeId)?.Name
                ?? "Donacija";

            var donationValue = model.Amount.HasValue
                ? $"{model.Amount.Value:N2} €"
                : string.IsNullOrWhiteSpace(model.ItemName)
                    ? "nije navedena"
                    : model.ItemName;

            var response = await Http.PostAsJsonAsync("api/ai/text", new AiTextRequestDto
            {
                Purpose = "donor-thank-you",
                Input =
                    $"Ton: {selectedTone}; Donator: {donorName}; " +
                    $"Tip donacije: {donationType}; Vrijednost ili sadržaj: {donationValue}; " +
                    $"Datum: {model.DonationDate:d}."
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AiTextResponseDto>();
            thankYouText = result?.Text;
        }
        catch (Exception ex)
        {
            errorMessage = $"Zahvalu nije moguće generirati: {ex.Message}";
        }
        finally
        {
            isGeneratingThankYou = false;
        }
    }
}