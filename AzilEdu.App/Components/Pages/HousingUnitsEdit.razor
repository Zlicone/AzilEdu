@page "/housing-units/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi smještajnu jedinicu</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici dohvaćamo postojeći zapis i spremamo promjene preko PUT zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudStack Spacing="2">
    <MudTextField @bind-Value="model.Name" Label="Naziv jedinice" Required="true" Immediate="true" />
    <MudTextField @bind-Value="model.UnitType" Label="Tip jedinice" Required="true" Immediate="true" />
    <MudNumericField @bind-Value="model.Capacity" Label="Kapacitet" />
    <MudNumericField @bind-Value="model.Occupied" Label="Zauzeto" />
    <MudDatePicker @bind-Date="lastCleanedAt" Label="Datum zadnjeg čišćenja" />
    <MudCheckBox @bind-Value="model.IsActive" Label="Aktivna jedinica" />
    <MudTextField @bind-Value="model.ImageUrl" Label="Putanja slike" Immediate="true" />
    <MudTextField @bind-Value="model.Note" Label="Napomena" Lines="3" Immediate="true" />

    <MudButton ButtonType="ButtonType.Button"
               OnClick="UpdateHousingUnit"
               Variant="Variant.Filled"
               Color="Color.Primary">
        Spremi promjene
    </MudButton>
</MudStack>

@code {
    [Parameter] public int Id { get; set; }

    private string? errorMessage;
    private SaveHousingUnitDto model = new();
    private DateTime? lastCleanedAt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var unit = await Http.GetFromJsonAsync<HousingUnitDto>($"api/housingunits/{Id}");

            if (unit is not null)
            {
                model = new SaveHousingUnitDto
                {
                    Name = unit.Name,
                    UnitType = unit.UnitType,
                    Capacity = unit.Capacity,
                    Occupied = unit.Occupied,
                    LastCleanedAt = unit.LastCleanedAt,
                    IsActive = unit.IsActive,
                    ImageUrl = unit.ImageUrl,
                    Note = unit.Note
                };

                lastCleanedAt = unit.LastCleanedAt;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja: {ex.Message}";
        }
    }

    private async Task UpdateHousingUnit()
    {
        try
        {
            errorMessage = null;

            if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrWhiteSpace(model.UnitType))
            {
                errorMessage = "Upiši barem obavezna polja: naziv i tip jedinice.";
                return;
            }

            if (model.Occupied > model.Capacity)
            {
                errorMessage = "Broj zauzetih mjesta ne može biti veći od kapaciteta.";
                return;
            }

            model.LastCleanedAt = lastCleanedAt;

            var response = await Http.PutAsJsonAsync($"api/housingunits/{Id}", model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/housing-units");
                return;
            }

            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
    }
}