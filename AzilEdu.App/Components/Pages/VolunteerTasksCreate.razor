@page "/volunteer-tasks/create"
@rendermode InteractiveServer

@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" Class="mb-4">Novi volonterski zadatak</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <MudPaper Class="pa-4">
        <MudTextField Label="Naslov" @bind-Value="model.Title" Required="true" Immediate="true" Class="mb-3" />
        <MudTextField Label="Opis" @bind-Value="model.Description" Lines="4" Immediate="true" Class="mb-3" />
        <MudDatePicker Label="Rok" @bind-Date="model.DueDate" Class="mb-3" />
        @if (IsCompletedStatusSelected())
        {
            <MudDatePicker Label="Datum završetka" @bind-Date="model.CompletedAt" Class="mb-3" />
        }

        <MudSelect T="int" Label="Status" @bind-Value="model.VolunteerTaskStatusId" Required="true" Class="mb-3">
            @foreach (var status in statuses)
            {
                <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int" Label="Tip zadatka" @bind-Value="model.VolunteerTaskTypeId" Required="true" Class="mb-3">
            @foreach (var type in types)
            {
                <MudSelectItem T="int" Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" Label="Volonter" @bind-Value="model.VolunteerId" Clearable="true" Class="mb-3">
            @foreach (var volunteer in volunteers)
            {
                <MudSelectItem T="int?" Value="@((int?)volunteer.Id)">@volunteer.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int?" Label="Životinja" @bind-Value="model.AnimalId" Clearable="true" Class="mb-3">
            @foreach (var animal in animals)
            {
                <MudSelectItem T="int?" Value="@((int?)animal.Id)">@animal.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField Label="Napomena" @bind-Value="model.Notes" Lines="3" Immediate="true" Class="mb-4" />

        <MudButton ButtonType="ButtonType.Button"
                   OnClick="SaveTask"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Spremi
        </MudButton>

        <MudButton Href="/volunteer-tasks" Variant="Variant.Text" Class="ml-2">
            Odustani
        </MudButton>
    </MudPaper>
}

@code {
    private SaveVolunteerTaskDto model = new();

    private List<LookupDto> statuses = new();
    private List<LookupDto> types = new();
    private List<LookupDto> volunteers = new();
    private List<LookupDto> animals = new();

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteertaskstatuses") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteertasktypes") ?? new();
            volunteers = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteers/lookup") ?? new();
            animals = await Http.GetFromJsonAsync<List<LookupDto>>("api/animals/lookup") ?? new();

            model.VolunteerTaskStatusId = statuses.FirstOrDefault()?.Id ?? 0;
            model.VolunteerTaskTypeId = types.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja forme: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsCompletedStatusSelected()
    {
        var status = statuses.FirstOrDefault(s => s.Id == model.VolunteerTaskStatusId);
        return status is not null && status.Name == "Završeno";
    }

    private string? ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(model.Title))
        {
            return "Naslov zadatka je obavezan.";
        }

        if (model.VolunteerTaskStatusId == 0)
        {
            return "Status zadatka je obavezan.";
        }

        if (model.VolunteerTaskTypeId == 0)
        {
            return "Tip zadatka je obavezan.";
        }

        if (IsCompletedStatusSelected() && !model.CompletedAt.HasValue)
        {
            return "Zadatak sa statusom Završeno mora imati datum završetka.";
        }

        if (!IsCompletedStatusSelected() && model.CompletedAt.HasValue)
        {
            return "Datum završetka smije imati samo zadatak sa statusom Završeno.";
        }

        return null;
    }

    private async Task SaveTask()
    {
        try
        {
            errorMessage = null;

            var validationError = ValidateForm();

            if (validationError is not null)
            {
                errorMessage = validationError;
                return;
            }

            var response = await Http.PostAsJsonAsync("api/volunteertasks", model);

            if (!response.IsSuccessStatusCode)
            {
                var apiMessage = await response.Content.ReadAsStringAsync();

                errorMessage = string.IsNullOrWhiteSpace(apiMessage)
                    ? $"Zadatak nije spremljen. Status: {(int)response.StatusCode}"
                    : apiMessage;

                return;
            }

            Navigation.NavigateTo("/volunteer-tasks");
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
    }
}