@page "/species"

<MudText Typo="Typo.h3" GutterBottom="true">
    Species
</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Ovdje će se prikazivati vrste životinja.
</MudText>

<MudGrid>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height:100%" Elevation="2">
            <MudImage Src="images/pas.png"
                      Alt="Pas"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h6">Psi</MudText>
            <MudText Typo="Typo.caption" Class="mb-2"><i>Canis familiaris</i></MudText>
            <MudText Typo="Typo.body2">
                Psi za udomljavanje.
            </MudText>
            <MudText Typo="Typo.body2">Životni vijek: 10–13 godina</MudText>
            <MudText Typo="Typo.body2">Prehrana: mesojed</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Trenutno u azilu: 24</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height:100%" Elevation="2">
            <MudImage Src="images/macke.png"
                      Alt="Macka"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h6">Macke</MudText>
            <MudText Typo="Typo.caption" Class="mb-2"><i>Felis catus</i></MudText>
            <MudText Typo="Typo.body2">
                Macke za udomljavanje.
            </MudText>
            <MudText Typo="Typo.body2">Životni vijek: 12–18 godina</MudText>
            <MudText Typo="Typo.body2">Prehrana: mesojed</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Trenutno u azilu: 31</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height:100%" Elevation="2">
            <MudImage Src="images/zec.png"
                      Alt="Zec"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h6">Zecevi</MudText>
            <MudText Typo="Typo.caption" Class="mb-2"><i>Oryctolagus cuniculus</i></MudText>
            <MudText Typo="Typo.body2">
                Zecevi za udomljavanje.
            </MudText>
            <MudText Typo="Typo.body2">Životni vijek: 8-12 godina</MudText>
            <MudText Typo="Typo.body2">Prehrana: biljojed</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Trenutno u azilu: 9</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 d-flex flex-column" Style="height:100%" Elevation="2">
            <MudImage Src="images/ptice.png"
                      Alt="Ptica"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h6">Ptice</MudText>
            <MudText Typo="Typo.caption" Class="mb-2"><i>Serinus canaria</i></MudText>
            <MudText Typo="Typo.body2">
                Ptice za udomljavanje.
            </MudText>
            <MudText Typo="Typo.body2">Životni vijek: 5-15 godina</MudText>
            <MudText Typo="Typo.body2">Prehrana: svejed</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Trenutno u azilu: 12</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

</MudGrid> 