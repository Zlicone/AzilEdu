@page "/animals/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi životinju</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici dohvaćamo postojeći zapis i spremamo promjene preko PUT zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudStack Spacing="2">
    <MudTextField @bind-Value="model.Name" Label="Ime" Required="true" Immediate="true" />
    <MudTextField @bind-Value="model.Species" Label="Vrsta" Required="true" Immediate="true" />
    <MudTextField @bind-Value="model.Breed" Label="Pasmina" Immediate="true" />
    <MudTextField @bind-Value="model.Gender" Label="Spol" Immediate="true" />
    <MudNumericField @bind-Value="model.Age" Label="Dob" />
    <MudDatePicker @bind-Date="arrivalDate" Label="Datum dolaska" />

    <MudSelect T="int"
               Label="Status"
               @bind-Value="model.AnimalStatusId"
               Variant="Variant.Outlined"
               Required="true">
        @foreach (var status in statusList)
        {
            <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
        }
    </MudSelect>

    <MudTextField @bind-Value="model.ImageUrl" Label="Putanja slike" Immediate="true" />
    <MudTextField @bind-Value="model.Description" Label="Opis" Lines="3" Immediate="true" />

    <MudButton ButtonType="ButtonType.Button"
               OnClick="UpdateAnimal"
               Variant="Variant.Filled"
               Color="Color.Primary">
        Spremi promjene
    </MudButton>
</MudStack>

@code {
    [Parameter] public int Id { get; set; }

    private string? errorMessage;
    private List<LookupDto> statusList = new();
    private SaveAnimalDto model = new();
    private DateTime? arrivalDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/animalstatuses") ?? new();

            var animal = await Http.GetFromJsonAsync<AnimalDto>($"api/animals/{Id}");

            if (animal is not null)
            {
                model = new SaveAnimalDto
                {
                    Name = animal.Name,
                    Species = animal.Species,
                    Breed = animal.Breed,
                    Gender = animal.Gender,
                    Age = animal.Age,
                    ArrivalDate = animal.ArrivalDate,
                    AnimalStatusId = animal.AnimalStatusId,
                    ImageUrl = animal.ImageUrl,
                    Description = animal.Description
                };

                arrivalDate = animal.ArrivalDate;
            }

            if (model.AnimalStatusId == 0 && statusList.Count > 0)
            {
                model.AnimalStatusId = statusList[0].Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja: {ex.Message}";
        }
    }

    private async Task UpdateAnimal()
    {
        try
        {
            errorMessage = null;

            if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrWhiteSpace(model.Species))
            {
                errorMessage = "Upiši barem obavezna polja: ime i vrstu.";
                return;
            }

            model.ArrivalDate = arrivalDate;

            var response = await Http.PutAsJsonAsync($"api/animals/{Id}", model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/animals");
                return;
            }

            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
    }
}